# ---- secrets: never commit ----
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p8

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- node / frontend ----
node_modules/
frontend/dist/
.vite/
*.tsbuildinfo

# ---- local deployment state ----
# One box's live config, not the project's defaults. Start it with
#   cp config.example.yaml config.yaml
# The template is committed and is what test_config.py asserts ships disarmed;
# this file is where you actually turn detectors on.
/config.yaml

# There is exactly one config location and it is the repo root. A zero-byte
# `backend/config.yaml` was committed once already (1ee5cd3, root-owned — a
# bind-mount artifact), harmless in the container because the real file is
# mounted over it, but a live trap for the host-run `cd backend && pytest`
# path where nothing shadows it.
/backend/config.yaml

# ---- data & runtime ----
pgdata/
data/runtime/
*.log

# ---- agent tooling ----
# Local tool permissions and scratch worktrees (each a full checkout).
.claude/

# ---- editors / os ----
.DS_Store
.idea/
.vscode/
*.swp
