# ============================================================================
# kalshi-copilot — environment configuration
#
# Copy to `.env` and fill in.  `.env` is gitignored and must NEVER be committed.
#   cp .env.example .env
#
# The RSA private keys referenced here are mounted READ-ONLY into the
# containers and are never logged.  Keep them outside the repo (default:
# ./secrets/, which is also gitignored).
# ============================================================================

# ---------------------------------------------------------------------------
# Environment selection
# ---------------------------------------------------------------------------
# `demo` (default) or `prod`.  Demo is the safe sandbox; credentials are NOT
# shared between environments — a demo key will not authenticate against prod.
KALSHI_ENV=demo

# Live-trading interlock.  Real orders require ALL THREE of:
#   1. KALSHI_ENV=prod
#   2. LIVE_TRADING=true
#   3. explicit confirmation in the UI modal
# Leave false unless you genuinely mean it.
LIVE_TRADING=false

# ---------------------------------------------------------------------------
# Kalshi API credentials — DEMO
# Generate at:  demo.kalshi.co  ->  Settings -> API Keys
# ---------------------------------------------------------------------------
KALSHI_DEMO_KEY_ID=00000000-0000-0000-0000-000000000000
KALSHI_DEMO_PRIVATE_KEY_PATH=/run/secrets/kalshi_demo_key.pem

# ---------------------------------------------------------------------------
# Kalshi API credentials — PRODUCTION
# Generate at:  kalshi.com  ->  Settings -> API Keys
# Leave as-is until you are ready to go live.
# ---------------------------------------------------------------------------
KALSHI_PROD_KEY_ID=00000000-0000-0000-0000-000000000000
KALSHI_PROD_PRIVATE_KEY_PATH=/run/secrets/kalshi_prod_key.pem

# ---------------------------------------------------------------------------
# Kalshi endpoints
# Defaults are the hosts docs.kalshi.com currently *recommends*.  The older
# `api.elections.kalshi.com` / `demo-api.kalshi.co` hosts remain valid and are
# listed as alternatives in the docs — override here if you need them.
# ---------------------------------------------------------------------------
KALSHI_PROD_REST_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_PROD_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2
KALSHI_DEMO_REST_URL=https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_DEMO_WS_URL=wss://external-api-ws.demo.kalshi.co/trade-api/ws/v2

# Rate-limit tier (drives the client-side token bucket).
# Basic tier = 200 read tokens/sec, 100 write tokens/sec, 10 tokens per request.
KALSHI_RATE_TIER=basic

# ---------------------------------------------------------------------------
# Anthropic API — used only by the M8 news/headline layer.
# Not required for milestones 0-7.  Spend is capped in config.yaml.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Datastores (internal to the compose network; not exposed to the host)
# ---------------------------------------------------------------------------
POSTGRES_USER=copilot
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_DB=kalshi_copilot
DATABASE_URL=postgresql+psycopg://copilot:change-me-before-first-run@db:5432/kalshi_copilot
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Dashboard binding — LAN ONLY.
# Reach it remotely over your existing WireGuard tunnel.  Do not port-forward
# this to the internet: there is no authentication in front of it by design.
# Set BIND_ADDR to a specific LAN IP (e.g. 192.168.1.50) to narrow it further.
# ---------------------------------------------------------------------------
BIND_ADDR=0.0.0.0
API_PORT=8080

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# `json` for structured logs, `console` for human-readable
LOG_FORMAT=console
